  "dune" {>= "3.20" & >= "3.18.0"}
  "yaml" {>= "3.0.0"}
  "core_unix" {>= "0.15.0"}
  "tyxml" {>= "4.5.0"}
  "omd" {>= "1.3.2"}
  "dream" {>= "1.0.0~alpha4"}
  "alcotest" {with-test}
  "qcheck" {with-test}
  "qcheck-alcotest" {with-test}
